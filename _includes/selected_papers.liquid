<div class="publication-browser" data-publication-browser>
  <div class="publication-filters" role="group" aria-label="Publication view" hidden>
    <button type="button" class="publication-filter" data-publication-filter="selected" aria-pressed="true" aria-controls="home-publications">Selected publications</button>
    <button type="button" class="publication-filter" data-publication-filter="recent" aria-pressed="false" aria-controls="home-publications">All recent papers</button>
  </div>
  <p class="publication-description" data-publication-description>All papers from 2024 onward.</p>
  <p class="publication-count" data-publication-count role="status" aria-live="polite" aria-atomic="true"></p>
  <div class="publications" id="home-publications">
    {% bibliography --group_by none --query @*[year>=2024]* %}
  </div>
  <p><a href="{{ '/publications/' | relative_url }}">Full publication archive &rarr;</a></p>
</div>
<script src="{{ '/assets/js/publication-filter.js' | relative_url }}" defer></script>
